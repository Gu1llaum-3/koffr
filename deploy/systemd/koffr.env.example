# Secrets for Koffr, referenced from koffr.yml as env:NAME.
#
# 0600, owned by the koffr user. Not the same file as koffr.yml: the
# configuration is meant to be safe to commit (EF-103), and this is not.
#
#   install -o koffr -g koffr -m 0600 koffr.env /etc/koffr/koffr.env

# The age identity that reads backups. Generated with `age-keygen`.
KOFFR_IDENTITY=AGE-SECRET-KEY-...

# One per source.
KOFFR_PG_PASSWORD=...

# Object store credentials, if the destination is S3 and the machine has no
# instance role.
#KOFFR_S3_KEY=...
#KOFFR_S3_SECRET=...

# Notification channels, if configured. A Slack or Healthchecks.io URL is a
# credential in its path, which is why it belongs here rather than in koffr.yml.
#KOFFR_WEBHOOK=https://hooks.slack.com/services/...
#KOFFR_DEAD_MANS_SWITCH=https://hc-ping.com/...
